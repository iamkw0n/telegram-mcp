# Telegram API credentials — issued at https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=

# Telethon StringSession produced by scripts/login.py after interactive login.
# Grants full read access to your Telegram account — treat like a password.
TG_SESSION_STRING=

# OPTIONAL. If set, callers must send it as "Authorization: Bearer <token>".
# Generate a random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to run with no auth — only do this when access is already gated
# elsewhere (Cloudflare Access in front of a named tunnel, or a short-lived
# unguessable trycloudflare.com quick-tunnel URL for local testing). Claude.ai's
# "Add custom connector" dialog has no field for a static bearer token, so for
# that flow leave this empty and rely on Cloudflare Access / URL secrecy instead.
MCP_AUTH_TOKEN=

# Host/port the MCP HTTP server listens on.
MCP_HOST=0.0.0.0
MCP_PORT=8811
