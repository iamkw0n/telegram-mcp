# Telegram API credentials — issued at https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=

# Telethon StringSession produced by scripts/login.py after interactive login.
# Grants full read access to your Telegram account — treat like a password.
TG_SESSION_STRING=

# --- Auth: pick ONE of the two options below (GitHub OAuth takes priority) ---

# Option A — GitHub OAuth ("Sign in with GitHub"). Required for the Claude.ai
# "Add custom connector" UI, which only supports OAuth. Create a GitHub OAuth
# App at https://github.com/settings/developers:
#   Homepage URL            = your public base URL (the cloudflared URL)
#   Authorization callback  = <that URL>/auth/callback
# Then fill in all four of these (all four must be set together):
PUBLIC_BASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_ALLOWED_USERNAME=

# Option B — static bearer token, for clients that support custom headers
# (e.g. Claude Code CLI). Callers must send "Authorization: Bearer <token>".
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ignored if the GitHub OAuth vars above are set.
MCP_AUTH_TOKEN=

# If neither option is configured, the server runs with no auth at all — only
# acceptable when access is already gated elsewhere (Cloudflare Access in
# front of a named tunnel, or a short-lived unguessable trycloudflare.com
# quick-tunnel URL for local testing).

# Host/port the MCP HTTP server listens on.
MCP_HOST=0.0.0.0
MCP_PORT=8811
